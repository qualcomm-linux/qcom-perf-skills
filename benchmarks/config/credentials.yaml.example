# credentials.yaml.example
# 
# This is a template for storing device connection credentials.
# Copy this file to 'credentials.yaml' and fill in your actual values.
# 
# IMPORTANT: credentials.yaml is in .gitignore and should NEVER be committed!
#
# Usage:
#   1. Copy this file: cp credentials.yaml.example credentials.yaml
#   2. Edit credentials.yaml with your actual device credentials
#   3. The framework will automatically load credentials from this file
#
# Alternative: Use environment variables instead (see README.md)

# SSH Connection (recommended for network-connected devices)
ssh:
  host: "192.168.1.100"           # Device IP address or hostname
  port: 22                         # SSH port (default: 22)
  username: "root"                 # SSH username
  password: "your_password_here"   # SSH password (or use key_file below)
  # key_file: "/path/to/private/key"  # Alternative: SSH private key path
  timeout: 30                      # Connection timeout in seconds

# Serial Connection (for devices without network)
serial:
  port: "/dev/ttyUSB0"            # Serial port (Linux: /dev/ttyUSB*, Windows: COM*)
  baudrate: 115200                # Baud rate (default: 115200)
  timeout: 10                     # Read timeout in seconds

# ADB Connection (for Android-based devices)
adb:
  serial: "ABC123456789"          # Device serial number (optional, for multi-device)
  # Leave empty to use first available device

# Device-Specific Settings (optional)
device:
  name: "IQ-9075-Lemans"          # Friendly device name for logging
  soc: "IQ-9075"                  # SoC identifier (matches config/benchmarks.yaml)
  
# Notes:
# - SSH is recommended for best performance and reliability
# - Serial connection is slower but works without network
# - ADB requires USB debugging enabled on device
# - Only one connection method is used at a time (specified via CLI flags)