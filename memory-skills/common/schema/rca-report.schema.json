{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://qualcomm.com/memory-skills/schemas/rca-report/1.0.0",
  "title": "RCAReport",
  "description": "Root cause analysis report produced by the anomaly-rca skill.",
  "type": "object",
  "required": ["schema_version", "generated_at", "anomalies", "summary"],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0.0" },
    "generated_at":   { "type": "string", "format": "date-time" },
    "input_reports":  { "type": "array", "items": { "type": "string" } },
    "anomalies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "severity", "confidence", "layer", "evidence", "hypothesis", "recommended_actions"],
        "properties": {
          "id":         { "type": "string" },
          "title":      { "type": "string" },
          "severity":   { "type": "string", "enum": ["CRITICAL", "WARNING", "INFO"] },
          "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
          "layer":      { "type": "string", "enum": ["kernel", "userspace", "nhlos", "system"] },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["source", "finding"],
              "properties": {
                "source":  { "type": "string" },
                "finding": { "type": "string" }
              }
            }
          },
          "hypothesis":           { "type": "string" },
          "recommended_actions":  { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "summary": {
      "type": "object",
      "required": ["overall_health"],
      "properties": {
        "critical":        { "type": "integer" },
        "warning":         { "type": "integer" },
        "info":            { "type": "integer" },
        "layers_affected": { "type": "array", "items": { "type": "string" } },
        "overall_health":  { "type": "string", "enum": ["HEALTHY", "DEGRADED", "CRITICAL"] }
      }
    }
  }
}